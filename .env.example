# Server only. PostgreSQL 16+; use a pooled URL on Vercel with the provider's TLS settings.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/copper_pirates
# Generate privately: node -e "process.stdout.write(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
# Must be the exact browser origin for this deployment; never allow a wildcard here.
BETTER_AUTH_URL=http://localhost:5173
API_PORT=3001
# Transactional email and optional inquiry notifications. Never use VITE_ prefixes for secrets.
RESEND_API_KEY=
EMAIL_FROM=
CONTACT_EMAIL=
# Required to use the authenticated image-upload endpoint in admin.
BLOB_READ_WRITE_TOKEN=
# Protects GET /api/cron/mail when configured in an external scheduler.
CRON_SECRET=
# Public settings only. The model remains noindex in HTML, robots.txt and Vercel headers.
VITE_SITE_URL=
VITE_INDEXING_ENABLED=false
